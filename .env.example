# ClayPipe — Environment Variables
# Copy to .env and fill in. NEVER commit .env (Rule 2).
# Empty values only — no placeholders, no fakes (Rule 3).

# ===== REQUIRED for --backend fal =====
# fal.ai API key. Get from: https://fal.ai/dashboard/keys
# Not needed for --backend dummy (the offline test backend).
FAL_KEY=
